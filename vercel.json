{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        { "type": "host", "value": "newsletter.orienting.lu" }
      ],
      "destination": "https://howmomai.substack.com/:path*",
      "statusCode": 301
    },
    {
      "source": "/coaching",
      "destination": "/",
      "statusCode": 308
    },
    {
      "source": "/portfolio",
      "destination": "/",
      "statusCode": 308
    },
    {
      "source": "/zh/coaching",
      "destination": "/zh/",
      "statusCode": 308
    },
    {
      "source": "/zh/portfolio",
      "destination": "/zh/",
      "statusCode": 308
    }
  ]
}
